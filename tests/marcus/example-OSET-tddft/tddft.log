DEFINITIONS
--------------------------------------------------------------------------
  Delta G° = G(D-P) + G(A-P) - G(D-R) - G(A-R)
  lambda R = [E(D-R at D-P) - E(D-R at D-R)]
           + [E(A-R at A-P) - E(A-R at A-R)]
  lambda P = [E(D-P at D-R) - E(D-P at D-P)]
           + [E(A-P at A-R) - E(A-P at A-P)]
  lambda = (lambda R + lambda P) / 2
  Delta G‡ (symmetric) = (lambda + Delta G°)^2 / (4 lambda)
  Delta G‡ (asymmetric) = lambda R * [(-lambda P +
    sqrt(lambda R * lambda P + (lambda R - lambda P) * Delta G°))
    / (lambda R - lambda P)]^2; equal lambdas use the symmetric limit.

