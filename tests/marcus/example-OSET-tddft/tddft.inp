# ============================================================================
# ComChemKit Marcus Barrier Input File
# Calculation type: OSET
# Generated by: cck marcus --genoset-input
# Edit this file and use with: cck marcus "marcus_oset.inp" -step <1|2|3>
# ============================================================================

# ----------------------------------------------------------------------------
# PROJECT IDENTIFICATION
# ----------------------------------------------------------------------------
# project = tddft        # Optional; defaults to input filename without extension
calc_type = tddftoset                   # oset | ent
workflow = manual              # manual | auto (auto runs all stages sequentially)
# qc_engine = g16              # required for auto; executable name or path
step = 1,2                     # manual: 1 = opt, 2 = sp, 3 = barriers; ignored in auto
                               # (default 1,2: generate both input sets up front;
                               #  submit step-1 jobs first, then step-2 jobs)

# ----------------------------------------------------------------------------
# DONOR / ACCEPTOR DEFINITIONS (shared by all steps)
# ----------------------------------------------------------------------------
# Donor
donor_name        = complex_9a
donor_xyz         = complex_9a.xyz
donor_init_charge = 1
donor_init_mult   = 1
donor_final_charge = 2
donor_final_mult  = 2

# Acceptor
acceptor_name        = RBr
acceptor_xyz         = RBr.xyz
acceptor_init_charge = 0
acceptor_init_mult   = 1
acceptor_final_charge = -1
acceptor_final_mult   = 2

# ----------------------------------------------------------------------------
# METHOD SELECTION (normal DFT default; TD-DFT for excited states S1, T2, ...)
# ----------------------------------------------------------------------------
# Set per species; per-state overrides let one state use TD-DFT and another DFT.
# For a TD-DFT state, charge/mult above are the SCF reference (e.g. 0 1);
# select the excited state with tddft_states and tddft_root.
# donor_method    = dft          # dft | tddft (default for both donor states)
# acceptor_method = dft          # dft | tddft
 donor_init_method     = tddft  # optional per-state override
# donor_final_method    = dft
# acceptor_init_method  = dft
# acceptor_final_method = dft

# TD-DFT route options (same names as input_gen calc_type = tddft)
 tddft_method  = tda            # tda | td
 tddft_states  = singlets       # singlets | triplets | 50-50 | blank
 tddft_nstates = 3              # number of excited states
# tddft_extra   = Root=1,Read    # extra keywords inside td/tda(...)
 tddft_root    = 1              # convenience -> Root=1
# step1_tddft_* / step2_tddft_*  # optional per-step overrides
# <state>_tddft_*                # optional per-state overrides

# ----------------------------------------------------------------------------
# STEP 1 THEORY — Geometry optimization + Freq at LOW level (opt_freq)
# All CreateInput opt_freq parameters supported, prefixed with step1_.
# ----------------------------------------------------------------------------
step1_functional      = uwb97xd
step1_basis           = def2svpp
#step1_basis_path      = /path/to/basis/ma-def2svpp.gbs
step1_solvent_model   = smd
step1_solvent         = water          # leave blank for gas phase
step1_scf_maxcycle    = 300
step1_opt_maxcycles   = 300
step1_opt_options     =
step1_scf_options     =
step1_opt_restart     = false
step1_scf_restart     = false
# step1_mem             = 20GB
# step1_nprocshared     = 16
# step1_cpu             =
# step1_gpucpu          =
# step1_print_level     = P
# step1_tail            =
# step1_route_extra_keywords =
# step1_tddft_method  =         # TD-DFT only; overrides global tddft_method
# step1_tddft_states  =
# step1_tddft_nstates =
# step1_tddft_extra   =

# ----------------------------------------------------------------------------
# STEP 2 THEORY — Single point at HIGH level (sp)
# All CreateInput sp parameters supported, prefixed with step2_.
# ----------------------------------------------------------------------------
step2_functional      = uwb97xd
step2_basis           = GenECP        # typically higher level than step1
step2_basis_path    = @/home/595/np9048/sources/BasisSetGaussian/ma-def2-TZVP.gbs/N  # for a custom basis
step2_solvent_model   = smd
step2_solvent         = water          # leave blank for gas phase
step2_solvent_extra   = ExternalIteration,NonEq=read  # ignored in gas phase
step2_scf_maxcycle    = 500
# step2_mem             = 20GB
# step2_nprocshared     = 16
# step2_cpu             =
# step2_gpucpu          =
# step2_print_level     =
# step2_tail            =
# step2_route_extra_keywords =
# step2_tddft_method  =         # TD-DFT only; overrides global tddft_method
# step2_tddft_states  =
# step2_tddft_nstates =
# step2_tddft_extra   =

# ----------------------------------------------------------------------------
# STEP 3 — Barrier calculation
# ----------------------------------------------------------------------------
report_level = default       # default | verbose; -v also enables verbose reporting
out_file =                   # progress/report path; default: <project>.log in current directory

# ----------------------------------------------------------------------------
# Thermochemistry settings for Barrier calculation
# ----------------------------------------------------------------------------
#temperature = 298.15          # K (for thermal corrections & phase correction)
#concentration = 1.0           # mol/L (for phase correction)
#pressure = 1.0                # atm (thermo recalculation; phase standard is fixed at 1 atm)
#low_vib_method = grimme       # harmonic|truhlar|grimme|minenkov|headgordon
#ravib = 100.0                 # cm^-1, crossover for quasi-RRHO
# scale_zpe = 1.0             # ZPE scaling factor
# scale_heat = 1.0            # Heat capacity scaling factor
# scale_entropy = 1.0         # Entropy scaling factor
# scale_cv = 1.0              # CV scaling factor
# interp_vib = 100.0          # cm^-1, vibrational interpolation parameter
# imag_real = 0.0             # Imaginary frequency threshold
# external_energy = 0.0       # External electronic energy (Hartree)
# mass_mode = 3               # Mass assignment mode
# prt_level = 1               # Output verbosity: 0=minimal, 1=default, 2=verbose, 3=full
# print_vib = 0               # Print vibration contributions
# ip_mode = 0                 # 0 for isolated systems, 1 for periodic solid state
# point_group =               # Point group label (e.g., C1, C2v, D2h)
# hg_entropy = false          # Enable entropy interpolation for Head-Gordon method
# bav_preset =                # qchem|grimme, Bav preset for free-rotor entropy
# output_otm = false          # Output .otm file flag
# use_input_temp = true       # uncomment to use -t pathway (thermo module)
# use_input_concentration = true  # uncomment to use -c pathway
# use_input_pressure = true   # uncomment to use thermo-module pressure pathway

# ----------------------------------------------------------------------------
# WORKFLOW INSTRUCTIONS
# ----------------------------------------------------------------------------
# Step 1: Generate geometry optimization inputs:
#   cck marcus "marcus_oset.inp" -step 1
#   -> Creates .gau files in <project>_step_1/
#   Submit these to Gaussian, wait for completion.

# Step 2: Generate single point inputs (reads step-1 checkpoints):
#   cck marcus "marcus_oset.inp" -step 2
#   -> Creates .gau files in <project>_step_2/
#   Submit these to Gaussian, wait for completion.

# Step 3: Calculate barriers:
#   cck marcus "marcus_oset.inp" -step 3
#   -> Calculates both symmetric and asymmetric barriers
#   Gas phase: leave both step1_solvent and step2_solvent blank.
# Automatic: set workflow = auto and qc_engine = g16, then run without -step.
#   -> Writes <project>.log in the current directory

